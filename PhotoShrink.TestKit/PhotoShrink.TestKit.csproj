<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test harness: makes test images, launches PhotoShrink the way Explorer does
       (one process per file), and checks the results. Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PhotoShrink.TestKit</RootNamespace>
  </PropertyGroup>

</Project>
